{
  "name": "my-music-app",
  "version": "1.0.0",
  "main": "desktop/main.js",
  "private": true,
  "build": {
    "appId": "com.auramusic.app",
    "productName": "Aura Music",
    "directories": {
      "output": "dist"
    },
    "files": [
      "desktop/**/*",
      "package.json"
    ],
    "win": {
      "target": ["nsis"],
      "icon": "public/icons/icon-512.png"
    },
    "mac": {
      "target": ["dmg"],
      "icon": "public/icons/icon-512.png"
    },
    "linux": {
      "target": ["AppImage"],
      "icon": "public/icons/icon-512.png"
    }
  },

  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:setup": "tsx scripts/migrate.ts && tsx scripts/seed.ts",
    "crawl": "tsx scripts/crawl.ts",
    "crawl:watchlist": "tsx scripts/crawl.ts --watchlist"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.12.0",
    "@types/pg": "^8.23.1",
    "music-metadata": "^11.16.1",
    "next": "16.3.6",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-redux": "^9.3.0"
  },
  "devDependencies": {
    "@netlify/plugin-nextjs": "^5.16.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
